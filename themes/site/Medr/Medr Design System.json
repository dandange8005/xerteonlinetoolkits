{
  "designSystem": {
    "metadata": {
      "name": "Medr (Commission for Tertiary Education and Research) Design System",
      "version": "1.0.0",
      "lastUpdated": "2026-01-22",
      "description": "Design system extracted from medr.cymru website - Welsh Government tertiary education commission",
      "language": "Bilingual (Welsh/English)",
      "purpose": "Government body website for tertiary education regulation and funding"
    },
    
    "principles": {
      "style": "Modern Welsh Government Design - Clean, Professional, Accessible",
      "values": [
        "Accessibility-first design following WCAG standards",
        "Bilingual support (Welsh and English)",
        "Clear information hierarchy",
        "Professional government aesthetic",
        "Mobile-responsive and inclusive",
        "Trust and transparency"
      ],
      "targetExperience": "Providing clear, accessible information about tertiary education funding and regulation to diverse stakeholders including learners, providers, and the public",
      "brandValues": [
        "Dysgu (to learn; to teach; to educate)",
        "Cydweithio (to work together; to collaborate)",
        "Cynnwys pawb (to include everyone)",
        "Rhagori (to exceed; to excel)"
      ]
    },
    
    "colours": {
      "primary": {
        "main": "#00703C",
        "light": "#00A551",
        "dark": "#004D2A",
        "contrastText": "#FFFFFF",
        "description": "Welsh Government Green - main brand colour"
      },
      "secondary": {
        "main": "#000000",
        "light": "#333333",
        "dark": "#000000",
        "description": "Black - used for text and secondary elements"
      },
      "accent": {
        "main": "#D4351C",
        "light": "#F47738",
        "dark": "#942514",
        "description": "Red accent - used for important CTAs and alerts"
      },
      "neutral": {
        "50": "#FAFAFA",
        "100": "#F5F5F5",
        "200": "#E5E5E5",
        "300": "#D4D4D4",
        "400": "#A3A3A3",
        "500": "#737373",
        "600": "#525252",
        "700": "#404040",
        "800": "#262626",
        "900": "#171717",
        "description": "Neutral grey scale"
      },
      "semantic": {
        "success": "#00703C",
        "warning": "#FFBF47",
        "error": "#D4351C",
        "info": "#1D70B8",
        "description": "Semantic colours for status and feedback"
      },
      "text": {
        "primary": "#0B0C0C",
        "secondary": "#505A5F",
        "disabled": "#B1B4B6",
        "hint": "#6F777B",
        "inverse": "#FFFFFF",
        "description": "Text colour hierarchy for government standards"
      },
      "background": {
        "default": "#FFFFFF",
        "paper": "#F3F4F6",
        "elevated": "#FFFFFF",
        "header": "#00703C",
        "footer": "#0B0C0C",
        "description": "Background colours for different sections"
      },
      "border": {
        "default": "#B1B4B6",
        "light": "#D4D4D4",
        "dark": "#505A5F",
        "focus": "#FFBF47",
        "description": "Border colours for inputs and separators"
      }
    },
    
    "typography": {
      "fontFamily": {
        "primary": "\"GDS Transport\", Arial, sans-serif",
        "fallback": "Arial, Helvetica, sans-serif",
        "code": "\"Courier New\", Courier, monospace",
        "description": "Welsh Government standard fonts with accessibility fallbacks"
      },
      "fontSize": {
        "h1": "48px",
        "h2": "36px",
        "h3": "27px",
        "h4": "24px",
        "h5": "19px",
        "h6": "16px",
        "body": "19px",
        "bodyLarge": "24px",
        "small": "16px",
        "tiny": "14px",
        "lead": "24px",
        "description": "Font sizes following Welsh Government Design System standards (larger for accessibility)"
      },
      "fontWeight": {
        "light": 300,
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700,
        "description": "Font weight scale"
      },
      "lineHeight": {
        "tight": 1.25,
        "normal": 1.5,
        "relaxed": 1.75,
        "loose": 2,
        "heading": 1.2,
        "body": 1.6,
        "description": "Line heights optimised for readability"
      },
      "letterSpacing": {
        "tight": "-0.01em",
        "normal": "0",
        "wide": "0.025em",
        "description": "Letter spacing for different contexts"
      }
    },
    
    "spacing": {
      "unit": 8,
      "scale": {
        "xxs": "4px",
        "xs": "8px",
        "sm": "12px",
        "md": "16px",
        "lg": "24px",
        "xl": "32px",
        "2xl": "48px",
        "3xl": "64px",
        "4xl": "80px",
        "5xl": "120px",
        "description": "8px-based spacing scale for consistency"
      },
      "section": {
        "vertical": "64px",
        "horizontalPadding": "24px",
        "containerPadding": "16px",
        "description": "Spacing for major page sections"
      }
    },
    
    "borderRadius": {
      "none": "0",
      "sm": "2px",
      "md": "4px",
      "lg": "8px",
      "xl": "12px",
      "full": "9999px",
      "description": "Border radius scale - government sites typically use minimal rounding"
    },
    
    "shadows": {
      "none": "none",
      "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
      "md": "0 2px 4px 0 rgba(0, 0, 0, 0.1)",
      "lg": "0 4px 8px 0 rgba(0, 0, 0, 0.1)",
      "xl": "0 8px 16px 0 rgba(0, 0, 0, 0.1)",
      "focus": "0 0 0 4px rgba(255, 191, 71, 0.5)",
      "description": "Subtle shadows for depth and focus states"
    },
    
    "components": {
      "header": {
        "backgroundColor": "$colours.primary.main",
        "colour": "$colours.text.inverse",
        "height": "auto",
        "padding": "$spacing.lg",
        "logo": {
          "maxHeight": "60px",
          "format": "SVG"
        },
        "navigation": {
          "fontSize": "$typography.fontSize.body",
          "fontWeight": "$typography.fontWeight.medium",
          "itemSpacing": "$spacing.md",
          "hoverBackgroundColor": "rgba(255, 255, 255, 0.1)"
        }
      },
      
      "button": {
        "primary": {
          "backgroundColor": "$colours.primary.main",
          "colour": "$colours.primary.contrastText",
          "borderRadius": "$borderRadius.none",
          "padding": "12px 24px",
          "fontSize": "$typography.fontSize.body",
          "fontWeight": "$typography.fontWeight.bold",
          "border": "2px solid transparent",
          "textTransform": "none",
          "states": {
            "hover": {
              "backgroundColor": "$colours.primary.dark",
              "boxShadow": "$shadows.md"
            },
            "focus": {
              "outline": "3px solid $colours.semantic.warning",
              "outlineOffset": "0",
              "boxShadow": "$shadows.focus"
            },
            "active": {
              "transform": "translateY(1px)",
              "boxShadow": "none"
            },
            "disabled": {
              "backgroundColor": "$colours.neutral.300",
              "colour": "$colours.text.disabled",
              "cursor": "not-allowed",
              "opacity": "0.5"
            }
          }
        },
        
        "secondary": {
          "backgroundColor": "transparent",
          "colour": "$colours.primary.main",
          "border": "2px solid $colours.primary.main",
          "borderRadius": "$borderRadius.none",
          "padding": "12px 24px",
          "fontSize": "$typography.fontSize.body",
          "fontWeight": "$typography.fontWeight.bold",
          "states": {
            "hover": {
              "backgroundColor": "$colours.primary.main",
              "colour": "$colours.primary.contrastText"
            },
            "focus": {
              "outline": "3px solid $colours.semantic.warning",
              "outlineOffset": "0"
            }
          }
        },
        
        "link": {
          "backgroundColor": "transparent",
          "colour": "$colours.semantic.info",
          "border": "none",
          "padding": "4px 0",
          "fontSize": "$typography.fontSize.body",
          "textDecoration": "underline",
          "states": {
            "hover": {
              "colour": "$colours.primary.dark",
              "textDecoration": "none"
            },
            "focus": {
              "outline": "3px solid $colours.semantic.warning",
              "backgroundColor": "$colours.semantic.warning",
              "colour": "$colours.text.primary"
            }
          }
        }
      },
      
      "card": {
        "backgroundColor": "$colours.background.paper",
        "borderRadius": "$borderRadius.none",
        "padding": "$spacing.xl",
        "boxShadow": "$shadows.md",
        "border": "1px solid $colours.border.light",
        "heading": {
          "fontSize": "$typography.fontSize.h4",
          "fontWeight": "$typography.fontWeight.bold",
          "marginBottom": "$spacing.md",
          "colour": "$colours.text.primary"
        },
        "content": {
          "fontSize": "$typography.fontSize.body",
          "lineHeight": "$typography.lineHeight.body",
          "colour": "$colours.text.secondary"
        },
        "states": {
          "hover": {
            "boxShadow": "$shadows.lg",
            "borderColor": "$colours.primary.main"
          }
        }
      },
      
      "input": {
        "backgroundColor": "$colours.background.default",
        "border": "2px solid $colours.border.default",
        "borderRadius": "$borderRadius.none",
        "padding": "8px 12px",
        "fontSize": "$typography.fontSize.body",
        "lineHeight": "$typography.lineHeight.normal",
        "colour": "$colours.text.primary",
        "minHeight": "44px",
        "states": {
          "focus": {
            "borderColor": "$colours.text.primary",
            "outline": "3px solid $colours.semantic.warning",
            "outlineOffset": "0",
            "boxShadow": "none"
          },
          "error": {
            "borderColor": "$colours.semantic.error",
            "borderWidth": "4px"
          },
          "disabled": {
            "backgroundColor": "$colours.neutral.100",
            "colour": "$colours.text.disabled",
            "cursor": "not-allowed"
          }
        },
        "label": {
          "fontSize": "$typography.fontSize.body",
          "fontWeight": "$typography.fontWeight.bold",
          "marginBottom": "$spacing.xs",
          "colour": "$colours.text.primary"
        },
        "hint": {
          "fontSize": "$typography.fontSize.body",
          "colour": "$colours.text.hint",
          "marginTop": "$spacing.xs"
        }
      },
      
      "navigation": {
        "mobile": {
          "menuButton": {
            "backgroundColor": "transparent",
            "colour": "$colours.text.inverse",
            "border": "none",
            "padding": "$spacing.md",
            "fontSize": "$typography.fontSize.body"
          },
          "overlay": {
            "backgroundColor": "$colours.primary.main",
            "colour": "$colours.text.inverse"
          }
        },
        "desktop": {
          "backgroundColor": "$colours.primary.main",
          "colour": "$colours.text.inverse",
          "itemPadding": "$spacing.md $spacing.lg",
          "dropdownBackground": "$colours.primary.dark"
        },
        "breadcrumb": {
          "fontSize": "$typography.fontSize.small",
          "colour": "$colours.text.secondary",
          "separator": "|",
          "linkColour": "$colours.semantic.info"
        }
      },
      
      "footer": {
        "backgroundColor": "$colours.background.footer",
        "colour": "$colours.text.inverse",
        "padding": "$spacing.3xl $spacing.lg",
        "linkColour": "$colours.text.inverse",
        "linkHoverColour": "$colours.neutral.300",
        "sectionSpacing": "$spacing.2xl",
        "logo": {
          "maxWidth": "200px",
          "filter": "brightness(0) invert(1)"
        }
      },
      
      "alert": {
        "padding": "$spacing.lg",
        "borderRadius": "$borderRadius.none",
        "borderLeft": "4px solid",
        "marginBottom": "$spacing.lg",
        "success": {
          "backgroundColor": "#D1E7DD",
          "borderColor": "$colours.semantic.success",
          "colour": "#0F5132"
        },
        "warning": {
          "backgroundColor": "#FFF3CD",
          "borderColor": "$colours.semantic.warning",
          "colour": "#664D03"
        },
        "error": {
          "backgroundColor": "#F8D7DA",
          "borderColor": "$colours.semantic.error",
          "colour": "#842029"
        },
        "info": {
          "backgroundColor": "#CFF4FC",
          "borderColor": "$colours.semantic.info",
          "colour": "#055160"
        }
      },
      
      "cookieBanner": {
        "backgroundColor": "$colours.neutral.100",
        "borderTop": "1px solid $colours.border.default",
        "padding": "$spacing.lg",
        "position": "fixed",
        "bottom": "0",
        "zIndex": "1000",
        "button": {
          "spacing": "$spacing.md"
        }
      },
      
      "languageToggle": {
        "fontSize": "$typography.fontSize.small",
        "fontWeight": "$typography.fontWeight.bold",
        "colour": "$colours.text.inverse",
        "padding": "$spacing.xs $spacing.md",
        "border": "1px solid $colours.text.inverse",
        "borderRadius": "$borderRadius.sm",
        "states": {
          "hover": {
            "backgroundColor": "rgba(255, 255, 255, 0.2)"
          }
        }
      },
      
      "valueCards": {
        "layout": "grid",
        "gridColumns": "repeat(auto-fit, minmax(250px, 1fr))",
        "gap": "$spacing.xl",
        "card": {
          "padding": "$spacing.xl",
          "backgroundColor": "$colours.background.paper",
          "border": "1px solid $colours.border.light",
          "title": {
            "fontSize": "$typography.fontSize.h5",
            "fontWeight": "$typography.fontWeight.bold",
            "colour": "$colours.primary.main",
            "marginBottom": "$spacing.sm"
          }
        }
      },
      
      "jobListing": {
        "backgroundColor": "$colours.background.paper",
        "border": "1px solid $colours.border.light",
        "padding": "$spacing.xl",
        "marginBottom": "$spacing.lg",
        "title": {
          "fontSize": "$typography.fontSize.h4",
          "fontWeight": "$typography.fontWeight.bold",
          "marginBottom": "$spacing.md"
        },
        "details": {
          "fontSize": "$typography.fontSize.body",
          "colour": "$colours.text.secondary",
          "lineHeight": "$typography.lineHeight.relaxed"
        },
        "button": {
          "marginTop": "$spacing.lg"
        }
      }
    },
    
    "layout": {
      "grid": {
        "columns": 12,
        "gutter": "24px",
        "description": "12-column responsive grid system"
      },
      "breakpoints": {
        "mobile": "320px",
        "tablet": "768px",
        "desktop": "1024px",
        "wide": "1280px",
        "max": "1440px",
        "description": "Responsive breakpoints for device targeting"
      },
      "container": {
        "maxWidth": "1200px",
        "padding": "0 24px",
        "margin": "0 auto",
        "description": "Main content container constraints"
      },
      "sections": {
        "hero": {
          "paddingTop": "$spacing.5xl",
          "paddingBottom": "$spacing.4xl",
          "backgroundColor": "$colours.background.default"
        },
        "content": {
          "paddingTop": "$spacing.3xl",
          "paddingBottom": "$spacing.3xl"
        }
      }
    },
    
    "accessibility": {
      "focusIndicator": {
        "outline": "3px solid $colours.semantic.warning",
        "outlineOffset": "0",
        "description": "Yellow focus indicator for keyboard navigation (WCAG AAA)"
      },
      "minimumTouchTarget": "44px",
      "minimumContrast": {
        "normal": "4.5:1",
        "large": "3:1",
        "description": "WCAG AA compliance requirements"
      },
      "skipLinks": {
        "position": "absolute",
        "top": "0",
        "left": "0",
        "backgroundColor": "$colours.semantic.warning",
        "colour": "$colours.text.primary",
        "padding": "$spacing.md",
        "zIndex": "9999",
        "clip": "rect(0, 0, 0, 0)",
        "states": {
          "focus": {
            "clip": "auto"
          }
        }
      }
    },
    
    "icons": {
      "style": "Outlined/Linear",
      "sizes": {
        "sm": "16px",
        "md": "24px",
        "lg": "32px",
        "xl": "48px"
      },
      "strokeWidth": "2px",
      "colour": "currentColor"
    },
    
    "images": {
      "ratios": {
        "square": "1:1",
        "landscape": "16:9",
        "portrait": "3:4",
        "logo": "variable"
      },
      "logoFormats": ["SVG", "PNG"],
      "placeholderBackground": "$colours.neutral.200",
      "lazyLoading": true
    },
    
    "interactionStates": {
      "hover": {
        "transitionDuration": "200ms",
        "transitionTimingFunction": "ease-in-out",
        "description": "Smooth transitions on hover"
      },
      "active": {
        "transform": "translateY(1px)",
        "description": "Subtle pressed effect"
      },
      "focus": {
        "outline": "$accessibility.focusIndicator.outline",
        "outlineOffset": "$accessibility.focusIndicator.outlineOffset",
        "description": "High visibility focus state"
      },
      "disabled": {
        "opacity": "0.5",
        "cursor": "not-allowed",
        "description": "Clear disabled state"
      },
      "loading": {
        "opacity": "0.6",
        "cursor": "wait",
        "description": "Loading state indication"
      }
    },
    
    "bilingual": {
      "defaultLanguage": "en",
      "supportedLanguages": ["en", "cy"],
      "languageLabels": {
        "en": "English",
        "cy": "Cymraeg"
      },
      "togglePosition": "top-right",
      "urlStructure": "/[lang]/[page]",
      "fontConsiderations": "Same font stack works for both Welsh and English"
    }
  }
}
